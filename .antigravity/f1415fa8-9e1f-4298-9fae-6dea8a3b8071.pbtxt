      create_file {
        instruction: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Heart, Sparkles, RotateCcw } from \'lucide-react\';\nimport { ANNIVERSARY_CONFIG } from \'../config/anniversary\';\nimport { romanticAudio } from \'../utils/audioSynthesizer\';\n\ninterface FinalSurpriseSceneProps {\n  onRestart: () => void;\n}\n\nexport const FinalSurpriseScene: React.FC<FinalSurpriseSceneProps> = ({ onRestart }) => {\n  const { final, recipientName } = ANNIVERSARY_CONFIG;\n\n  const handleRestartExperience = () => {\n    romanticAudio.playSparkleSound();\n    onRestart();\n  };\n\n  return (\n    <div className=\"relative flex min-h-[100dvh] w-full flex-col items-center justify-between px-4 sm:px-6 py-6 sm:py-12 select-none overflow-y-auto\">\n      {/* Top Editorial Kicker */}\n      <motion.div\n        initial={{ opacity: 0, y: -10 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.6 }}\n        className=\"flex items-center gap-2 text-xs md:text-sm font-sans tracking-[0.25em] uppercase text-[#e5a4b4]/90\"\n      >\n        <span>Chapter IV</span>\n        <span aria-hidden=\"true\" className=\"text-[#dfb285]\">\302\267</span>\n        <span>The Final Chapter</span>\n      </motion.div>\n\n      {/* Main Night Sky Romantic Message Container */}\n      <div className=\"my-auto flex w-full max-w-xl flex-col items-center space-y-8 sm:space-y-10 py-6 text-center\">\n        {/* Dreamy Final Animated Heart */}\n        <motion.div\n          initial={{ scale: 0.5, opacity: 0 }}\n          animate={{ scale: 1, opacity: 1 }}\n          transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n          className=\"relative flex h-24 w-24 sm:h-28 sm:w-28 items-center justify-center rounded-full bg-gradient-to-tr from-[#521327] via-[#94314e] to-[#dfb285]/70 border border-[#f5c7d2]/50 shadow-[0_0_60px_rgba(214,125,138,0.45)]\"\n        >\n          {/* Beating Heart Icon */}\n          <motion.div\n            animate={{ scale: [1, 1.14, 1] }}\n            transition={{ duration: 2.2, repeat: Infinity, ease: \'easeInOut\' }}\n          >\n            <Heart className=\"h-12 w-12 sm:h-14 sm:w-14 text-[#fff0f4] fill-[#fff0f4] drop-shadow-[0_4px_16px_rgba(0,0,0,0.5)]\" />\n          </motion.div>\n\n          {/* Ethereal Halo Rings */}\n          <motion.div\n            className=\"absolute inset-0 rounded-full border border-[#ffe0e8]\"\n            animate={{ scale: [1, 1.35, 1], opacity: [0.8, 0.1, 0.8] }}\n            transition={{ duration: 2.5, repeat: Infinity, ease: \'easeInOut\' }}\n          />\n          <motion.div\n            className=\"absolute -inset-3 rounded-full border border-[#dfb285]\"\n            animate={{ scale: [1, 1.5, 1], opacity: [0.5, 0, 0.5] }}\n            transition={{ duration: 2.5, delay: 0.5, repeat: Infinity, ease: \'easeInOut\' }}\n          />\n        </motion.div>\n\n        {/* The Two Main Story Messages */}\n        <div className=\"space-y-5 px-2\">\n          {/* Message 1: \"This is only the first chapter of our story...\" */}\n          <motion.p\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.25, duration: 0.8 }}\n            className=\"font-serif italic text-xl sm:text-2xl md:text-3xl text-[#f5d7df] tracking-wide max-w-lg mx-auto leading-relaxed\"\n            style={{ fontFamily: \'\"Playfair Display\", Georgia, serif\' }}\n          >\n            \"{final.message1}\"\n          </motion.p>\n\n          {/* Decorative Divider */}\n          <motion.div\n            initial={{ scaleX: 0, opacity: 0 }}\n            animate={{ scaleX: 1, opacity: 1 }}\n            transition={{ delay: 0.45, duration: 0.6 }}\n            className=\"flex items-center justify-center gap-3 py-1\"\n          >\n            <div className=\"h-px w-12 sm:w-16 bg-gradient-to-r from-transparent to-[#dfb285]\" />\n            <Sparkles className=\"h-4 w-4 text-[#dfb285]\" />\n            <div className=\"h-px w-12 sm:w-16 bg-gradient-to-l from-transparent to-[#dfb285]\" />\n          </motion.div>\n\n          {/* Message 2: \"Forever to go, my love. \342\235\244\357\270\217\" */}\n          <motion.h2\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.65, duration: 0.8 }}\n            className=\"font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight bg-gradient-to-r from-[#ffffff] via-[#ffe3ea] to-[#dfb285] bg-clip-text text-transparent drop-shadow-[0_4px_20px_rgba(255,255,255,0.2)]\"\n            style={{ fontFamily: \'\"Playfair Display\", Georgia, serif\' }}\n          >\n            {final.message2}\n          </motion.h2>\n        </div>\n\n        {/* Replay Experience Action Button */}\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.85, duration: 0.7 }}\n          className=\"pt-4\"\n        >\n          <button\n            onClick={handleRestartExperience}\n            className=\"group relative inline-flex items-center justify-center gap-2.5 px-9 py-4 min-h-[54px] min-w-[240px] rounded-full bg-gradient-to-r from-[#94314e] via-[#b64b67] to-[#862540] text-[#fff5f7] font-sans text-sm sm:text-base font-semibold tracking-wide shadow-[0_6px_25px_rgba(148,49,78,0.5)] hover:shadow-[0_8px_32px_rgba(148,49,78,0.7)] hover:scale-105 active:scale-95 transition-all cursor-pointer touch-manipulation border border-[#f5c7d2]/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dfb285]\"\n          >\n            <RotateCcw className=\"h-4 w-4 text-[#ffd1dc] group-hover:-rotate-90 transition-transform\" />\n            <span>{final.replayButtonText}</span>\n          </button>\n        </motion.div>\n      </div>\n\n      {/* Quiet Bottom Kicker */}\n      <motion.p\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.65 }}\n        transition={{ delay: 0.95 }}\n        className=\"text-[11px] sm:text-xs font-sans text-[#e5a4b4]/75 tracking-wider\"\n      >\n        Happy 1st Anniversary, {recipientName} \342\231\241 Forever & Always\n      </motion.p>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/scenes/FinalSurpriseScene.tsx"
        }
        overwrite: true
      }
    }

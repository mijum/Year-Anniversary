      thinking_signature: "\022\260\027\n\255\027\001i\024}\023!r\374d\345F\251\232\255\342-\037\355Fi\005\"\034PZ\251z\033\264rfHC\016^B\337\260s\206\233109l\0269\244\222\231\004\214\214\005\004\366\371\375\024\001\343\277\274\311\351\261\203Jx=\266\360\001\254\023i\037^Ihrq\207N\213\243.\2113/k\375\2626\256\243s\177\364{z\3436$\257\"\250*\272\274\353C\0213\200(v\302\272#@\241Av\"\005\217\020\273\005!\264>(^:\321\207F\200#\030(\023+\273\363\b\303R\343\267\231j\324\235\250,2\344\f\344#w\243Lt\366x\201DY\311\254A\365\220\020\365\032\000A\306%\313\031\275z\022\345\t \030\250\235\203/4\332tE\370\351V\233\214>F\016K\351\364\323\305\225_\207\377\355{\340\366p\273\225\247\353\036\3131)\022\\\211\0355\227y\214H6>a\302\232k\213\005\021v#\254`\330\325S\230-\267\032\211\035s\253\352\344\275\005p\302\231Or\205\224{\232\315_\216\355\213\227lF\254\340\rrF\267S\332\016MZ\301}\206\21698c\017\274\237?^\206\016\344my;k\353\210\035\'`\026\257\323U\316\036\214Zc\256W\301?\222h\215\250$\320)=\273\257gj\273\240t4C\2252\031\200Hk\221\205*\355t\257\267\353\273\362\277lC\322\a\357\335@WWF\031\303\250i\233\340\347-R\016\0276K\207\250<\304\'\255\233\325_f\251\234\221r\002\272\v8\027}\245\226\320\206\020\311\315\372z3\032\252!\337lw\355Lt)C\334-\306\035/\260\213\032+Z\036\030j\370\2402\260\377\ve\253\373+\312\262\267\217u\372O\326\366\204\353\347d\300\032\374\b\323\n\344\365{\334Iw\334\004_8c\231x\272T\222\376\307\2729\243\210\317\035\367\254\3617d\225\203\215\004lKI\314\273\236\255\330\302\bU\211+@V<i[j\347\200\037\311t\246<\263\303p\276\361\260\2054T\306\360\017\214R\343\006n^_\370h\207\016H\022=4\377\245\250C\022\237\001O\271\021w@\030X\324.\277\\\"Ij\304\357\202\"\252\316aS\267y\353\372\353\240\324\320!\000\2549\307\255\336\212\372\226\'\031R\031\346\376D\305\311\310tH\377\2512\357|\374\363\326\0318K_\346\356\354\363o\271\350.\311VW,\24354V\275k\330\025\371\302\355\301\315\347r\200\211\220WU\371\247\325\311\307\277\246\234\003\004\271> \2374\253\241\347\337)\262^@\a\033\307R\211\257~\355\
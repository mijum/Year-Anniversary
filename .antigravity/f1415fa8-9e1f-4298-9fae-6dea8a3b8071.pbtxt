      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState, useCallback } from \'react\';\\nimport { AnniversarySceneId } from \'../types/anniversary\';\\n\\nexport const SCENE_ORDER: readonly AnniversarySceneId[] = [\\n  \'WELCOME\',\\n  \'LOVE_LETTER\',\\n  \'PHOTOGRAPHS\',\\n  \'ANNIVERSARY_REVEAL\',\\n  \'FINAL_SURPRISE\',\\n] as const;\\n\\nexport function useSceneManager(initialScene: AnniversarySceneId = \'WELCOME\') {\\n  const [currentScene, setCurrentScene] = useState<AnniversarySceneId>(initialScene);\\n\\n  // Moves to the next scene in the story\\n  const nextScene = useCallback(() => {\\n    setCurrentScene((prev) => {\\n      const currentIndex = SCENE_ORDER.indexOf(prev);\\n      if (currentIndex === -1) return SCENE_ORDER[0];\\n      const nextIndex = (currentIndex + 1) % SCENE_ORDER.length;\\n      return SCENE_ORDER[nextIndex];\\n    });\\n  }, []);\\n\\n  // Directly sets a specific target scene\\n  const goToScene = useCallback((targetScene: AnniversarySceneId) => {\\n    setCurrentScene(targetScene);\\n  }, []);\\n\\n  // Resets cleanly back to the first scene (WELCOME)\\n  const restartExperience = useCallback(() => {\\n    setCurrentScene(SCENE_ORDER[0]);\\n  }, []);\\n\\n  return {\\n    currentScene,\\n    nextScene,\\n    goToScene,\\n    restartExperience,\\n  };\\n}\\n\", \"Description\":\"Update scene manager hook for the 5 anniversary scenes\", \"Overwrite\":true, \"TargetFile\":\"/src/hooks/useSceneManager.ts\", \"toolAction\":\"Updating useSceneManager.ts\", \"toolSummary\":\"Update src/hooks/useSceneManager.ts\"}"

      description: "Execute-First migration for GitHub repositories imported into AI Studio. Triages projects and routes to the appropriate self-contained migration reference. Supports Web (Node.js) and Android (Kotlin/Compose) runtimes."
    }
    line_range_bytes: 2312
  }

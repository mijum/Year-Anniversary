      thinking_signature: "\022\205\021\n\202\021\001i\024}\023\330\2261\312u\321\235a\354\352\243\360\246\202\264\023\355&\344\311\027\317y\023\264\210\002\233\352@\230\216q\273\005\3677\246VN\367\234t\243e\266 \tn\314\364\227\224H\226\b\200\375\207?\326\374\253\352\3430\271GBlq\035i\aw5\031\203\317\\0\006\n\310\370G\214\004\000\223\206\231\212\233\224B\273KMC\203\253D\214\000\240\342D\226\223\264\017\304o\323%F\320m\006\314r2\234\204\314\224_\330\315/\273\2703Ae\274a~\177\362L\373\271:*\030\364k\267\002\364\216\230\313c\321\034N\353\333u\302\236\304D\005\323q\017\356\325\327\216\360\361!\346\363\265$\3523\301&\030\346>Z\2322\213\005\352\034\0325\3450\255t\036\0261\215-\"\277\257\034\220\004\207Md\020\214+\364Ea_\0214\375\277\367\263y\222N\005\f\364\312\276U\317H\325\312\320\1771\025\200\225\340\205\017\303\275\374Q\213h\207\324\264\361:\242\3153w\334\200\250\364\021\302>\261nF\006\201\023\325\302\256\220\364\321mo\251(/\256\023j&\251k\nX\220\354D\234\315\226\214p\302\321\376\352V_\v\372\330\026:\034,\201\026\332D\343<G_\274\210\266d\334\227\2311\250\307Sti\024\307eq\334[\"o~;\302\203!\274b\316cgU\273\343\314\246NUZ\177+\315\r\222\022~\210\357q\a\f\300%\314\201\322 \301\004\241\355Y\322\320\215\333}\235\252\221UN\032\305\362\340\242\256\335\335\257G%\267\213\375\236\322\216u\364x\246\337\0039:\202\312\370Xr\306-\005\333\263\2546i\307c\'\266\311\251\243\277\\\342\252fBL2<\350\307X)\305*\2773\201\356\336\233%?\262\234\025\335\026\a`j\260\237\v\374:\374\337\005\242\031a>\322$\236\031<_\236\222k*\350\314\352S\255\257\345\317\304\327{\nM_\"(\034\2456\313\256\201Q\200\325tsz{\326\300&\032\227\3047\267\017\373\276\267\307F\220\n\366\001\370\266!&\025\364\'\276_\317p\a\324g;R\037\\\371%w\241\273\256.\360k\267X\t\222m\323\020\236\215^\2610$\330\365\245\f\377\336\005W\270\361K\320eZ\2356H\314J\216p\366\241)Nh\215}!\337\3208\"\206\230\200\327\a\267\235T\365u\232\t\016\321\253\021b\347\234\212\353\232/\375\360Y\271\034\341E\312\357\330\034\246\300\333\241\035(\347\2047\347\313
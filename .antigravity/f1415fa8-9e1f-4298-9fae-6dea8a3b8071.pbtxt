  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Heart, Sparkles } from \'lucide-react\';\nimport { ANNIVERSARY_CONFIG } from \'../config/anniversary\';\nimport { romanticAudio } from \'../utils/audioSynthesizer\';\n\ninterface WelcomeSceneProps {\n  onContinue: () => void;\n  onUserInteraction: () => void;\n}\n\nexport const WelcomeScene: React.FC<WelcomeSceneProps> = ({\n  onContinue,\n  onUserInteraction,\n}) => {\n  const [isOpening, setIsOpening] = useState(false);\n\n  const handleOpenSurprise = () => {\n    if (isOpening) return;\n    onUserInteraction();\n    setIsOpening(true);\n    romanticAudio.playEnvelopeOpenSound();\n\n    setTimeout(() => {\n      onContinue();\n    }, 1000);\n  };\n\n  return (\n    <div\n      onClick={onUserInteraction}\n      className=\"relative flex min-h-[100dvh] w-full flex-col items-center justify-between px-4 py-8 sm:py-12 text-center select-none overflow-y-auto\"\n    >\n      {/* Top Editorial Kicker */}\n      <motion.div\n        initial={{ opacity: 0, y: -12 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.8 }}\n        className=\"flex items-center gap-2 text-xs md:text-sm font-sans tracking-[0.25em] uppercase text-[#e5a4b4]/85\"\n      >\n        <span>{ANNIVERSARY_CONFIG.projectName}</span>\n        <span aria-hidden=\"true\" className=\"text-[#dfb285]\">\302\267</span>\n        <span>For {ANNIVERSARY_CONFIG.recipientName}</span>\n      </motion.div>\n\n      {/* Main Centerpiece: Message + Floating Animated Envelope */}\n      <div className=\"my-auto flex w-full max-w-lg flex-col items-center space-y-7 sm:space-y-8 py-4\">\n        {/* Intro Message */}\n        <motion.div\n          initial={{ opacity: 0, y: 16 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.9, delay: 0.15 }}\n          className=\"space-y-2\"\n        >\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 text-xs font-sans tracking-widest uppercase text-[#dfb285]/90\">\n            <Sparkles className=\"h-3.5 w-3.5 text-[#dfb285]\" />\n            <span>A Special Surprise</span>\n            <Sparkles className=\"h-3.5 w-3.5 text-[#dfb285]\" />\n          </div>\n          <h1 className=\"font-serif text-2xl sm:text-3xl md:text-4xl font-medium tracking-wide text-[#fdf0f4] text-balance max-w-md mx-auto leading-relaxed\">\n            {ANNIVERSARY_CONFIG.welcomeMessage}\n          </h1>\n        </motion.div>\n\n        {/* Floating Animated Sealed Envelope */}\n        <motion.div\n          animate={\n            !isOpening\n              ? {\n                  y: [0, -10, 0],\n                  rotate: [-0.5, 0.8, -0.5],\n                }\n              : {\n                  scale: [1, 1.05, 0.95],\n                }\n          }\n          transition={{\n            y: { duration: 4.5, repeat: Infinity, ease: \'easeInOut\' },\n            rotate: { duration: 6, repeat: Infinity, ease: \'easeInOut\' },\n          }}\n          className=\"relative w-full max-w-[340px] sm:max-w-[380px] cursor-pointer\"\n          onClick={handleOpenSurprise}\n          role=\"button\"\n          tabIndex={0}\n          onKeyDown={(e) => {\n            if (e.key === \'Enter\' || e.key === \' \') {\n              e.preventDefault();\n              handleOpenSurprise();\n            }\n          }}\n          aria-label=\"Open anniversary envelope\"\n        >\n          {/* Subtle Outer Glow Halo */}\n          <div className=\"absolute -inset-4 rounded-3xl bg-gradient-to-r from-[#dfb285]/20 via-[#d67d8a]/25 to-[#dfb285]/20 blur-xl opacity-75\" />\n\n          {/* Envelope Body Container */}\n          <div className=\"relative aspect-[16/11] w-full rounded-2xl sm:rounded-3xl bg-[#faf5ee] shadow-[0_20px_50px_rgba(20,5,15,0.6),0_0_0_1px_rgba(235,190,195,0.4)] overflow-hidden border border-[#ead8dc] transition-transform duration-300 hover:scale-[1.02]\">\n            {/* Elegant Flatlay Envelope Texture */}\n            <img\n              src=\"/letter.jpg\"\n              alt=\"Romantic envelope on floral bed\"\n              className={`h-full w-full object-cover transition-all duration-700 ${\n                isOpening ? \'scale-110 filter blur-[1px] opacity-75\' : \'scale-100\'\n              }`}\n            />\n\n            {/* Tinted Warm Scrim */}\n            <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#200814]/75 via-transparent to-[#200814]/30\" />\n\n            {/* Letter Paper Sliding Out Animation on Open */}\n            <AnimatePresence>\n              {isOpening && (\n                <motion.div\n                  initial={{ y: 90, opacity: 0, scale: 0.9 }}\n                  animate={{ y: -15, opacity: 1, scale: 1 }}\n                  transition={{ duration: 0.65, ease: [0.16, 1, 0.3, 1] }}\n                  className=\"absolute inset-x-5 top-6 bottom-6 rounded-2xl bg-[#fdfaf4] shadow-2xl p-5 border border-[#e5ccd3] flex flex-col justify-center space-y-2.5 z-30\"\n                >\n                  <div className=\"h-3 w-28 bg-[#94314e]/40 rounded-full mx-auto\" />\n                  <div className=\"h-2 w-full bg-[#94314e]/20 rounded-full\" />\n                  <div className=\"h-2 w-5/6 bg-[#94314e]/20 rounded-full mx-auto\" />\n                  <div className=\"h-2 w-4/6 bg-[#94314e]/20 rounded-full mx-auto\" />\n                </motion.div>\n              )}\n            </AnimatePresence>\n\n            {/* Glowing Heart Wax Seal (Centered) */}\n            {!isOpening && (\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-20\">\n                <motion.div\n                  animate={{ scale: [1, 1.12, 1] }}\n                  transition={{ duration: 2.2, repeat: Infinity, ease: \'easeInOut\' }}\n                  className=\"relative flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-[#dfb285] via-[#d67d8a] to-[#862540] shadow-[0_6px_25px_rgba(214,125,138,0.7),inset_0_2px_4px_rgba(255,255,255,0.5)] border-2 border-[#fff0f4]\"\n                >\n                  <Heart className=\"h-8 w-8 text-[#fff0f4] fill-[#fff0f4]\" />\n\n                  {/* Pulsing Aura */}\n                  <motion.div\n                    className=\"absolute inset-0 rounded-full border border-[#ffe4eb]\"\n                    animate={{ scale: [1, 1.4, 1], opacity: [0.8, 0, 0.8] }}\n                    transition={{ duration: 2.2, repeat: Infinity, ease: \'easeInOut\' }}\n                  />\n                </motion.div>\n\n                <span className=\"mt-3 text-[11px] sm:text-xs font-sans font-semibold tracking-widest uppercase text-[#fff0f4] bg-[#220712]/85 px-4 py-1.5 rounded-full border border-[#e8a2b5]/40 shadow-lg backdrop-blur-sm\">\n                  Tap to Open\n                </span>\n              </div>\n            )}\n          </div>\n        </motion.div>\n\n        {/* Primary Action Button */}\n        <motion.div\n          initial={{ opacity: 0, y: 15 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, delay: 0.35 }}\n          className=\"pt-2\"\n        >\n          <button\n            onClick={handleOpenSurprise}\n            disabled={isOpening}\n            className=\"group relative inline-flex items-center justify-center gap-2.5 px-9 py-4 min-h-[54px] min-w-[240px] rounded-full bg-gradient-to-r from-[#94314e] via-[#b64b67] to-[#862540] text-[#fff5f7] font-sans text-sm sm:text-base font-semibold tracking-wide shadow-[0_6px_25px_rgba(148,49,78,0.5)] hover:shadow-[0_8px_32px_rgba(148,49,78,0.7)] hover:scale-105 active:scale-95 transition-all cursor-pointer touch-manipulation border border-[#f5c7d2]/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#dfb285]\"\n          >\n            <span>{isOpening ? \'Opening Your Story...\' : ANNIVERSARY_CONFIG.welcomeButtonText}</span>\n            {!isOpening && (\n              <Heart className=\"h-4 w-4 text-[#ffd1dc] fill-[#ffd1dc] group-hover:scale-110 transition-transform\" />\n            )}\n          </button>\n        </motion.div>\n      </div>\n\n      {/* Quiet Bottom Attribution */}\n      <motion.p\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.6 }}\n        transition={{ delay: 0.6 }}\n        className=\"text-[11px] sm:text-xs font-sans text-[#e5a4b4]/70 tracking-wider\"\n      >\n        A 1st Anniversary Story Dedicated with All My Heart\n      </motion.p>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/scenes/WelcomeScene.tsx"
        }
        overwrite: true
      }
    }
